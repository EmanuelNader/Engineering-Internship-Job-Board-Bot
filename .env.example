DISCORD_TOKEN=your_dev_bot_token_here
# Optional but recommended — unauthenticated GitHub API is rate-limited
GITHUB_TOKEN=your_github_pat_here

# SQLite path is relative to prisma/schema.prisma, so this file is prisma/dev.db
DATABASE_URL="file:./dev.db"

# First-boot channel seeding (posts to Discord, rate-limited). Keep false except first prod boot.
BACKFILL=false
BACKFILL_LIMIT=50

# GitHub README ingest: skip listings older than this (Age / Date Posted columns)
GITHUB_MAX_AGE_DAYS=14

# On first join, also post listings from this many days before today (0 = today only)
INITIAL_LOOKBACK_DAYS=7

# Commit posted roles to data/listings.json and docs/internships.md. Empty disables.
# GITHUB_TOKEN needs Contents: Read and write on that repo (a read-only token is not enough).
LISTINGS_REPO=
LISTINGS_BRANCH=main
